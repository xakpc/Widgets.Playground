{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "backgroundImage": {
    "url": "ms-appx:///Assets/background-small.png",
    "fillMode": "Cover",
    "horizontalAlignment": "Center",
    "verticalAlignment": "Center"
  },
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "items": [
        {
          "type": "TextBlock",
          "text": "Cat Fact",
          "weight": "Bolder",
          "size": "Medium"
        },
        {
          "type": "TextBlock",
          "text": "${fact}",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${errorMessage}",
          "wrap": true,
          "color": "Warning",
          "isSubtle": true,
          "size": "Small",
          "$when": "${errorMessage != null}"
        },
        {
          "type": "TextBlock",
          "text": "Size: ${$host.widgetSize}",
          "isSubtle": true,
          "size": "Small",
          "$when": "${$host.widgetSize != \"small\"}"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Refresh",
      "verb": "refresh"
    }
  ]
}
